# Required for any "Try it" call. Get yours at https://www.last.fm/api/account/create
LASTFM_API_KEY=your-api-key

# Required for signed methods (auth.getToken, auth.getSession, auth.getMobileSession,
# and any write method — track.scrobble, track.love, track.addTags, ...).
LASTFM_SHARED_SECRET=your-shared-secret

# Required for write methods (POST signed). Obtain it via auth.getMobileSession
# (call it from the Scalar UI with your username + password), or via the
# browser-based auth flow documented in the Last.fm API docs.
LASTFM_SESSION_KEY=

# Port the local docs server binds to.
PORT=3000
